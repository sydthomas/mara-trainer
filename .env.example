# Copy to .env (gitignored) only if you need overrides. No real values belong in this file.

# Where the SQLite database lives (default: data/coach.db)
COACH_DB_PATH=data/coach.db

# Optional, OFF by default. Unofficial Garmin Connect access (garmin_mcp / python-garminconnect)
# is personal-use-only and at your own risk. Prefer FIT exports.
GARMIN_MCP_ENABLED=false

# Strava: there is intentionally NO Strava client id/secret here.
# Strava is used only through the official Strava MCP (https://mcp.strava.com/mcp),
# authorized in Claude Code with /mcp. Never sync Strava data into this repo or the DB.
